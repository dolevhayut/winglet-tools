{
  "name": "@winglet/next",
  "version": "0.2.1",
  "description": "Read content from Winglet in a Next.js App Router site: typed accessors, signed image derivatives, and tagged caching that a publish invalidates.",
  "license": "MIT",
  "author": "Dolev Hayut",
  "homepage": "https://github.com/dolevhayut/winglet-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolevhayut/winglet-tools.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/dolevhayut/winglet-tools/issues"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "nextjs",
    "app-router",
    "content",
    "sdk",
    "rtl",
    "hebrew"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./revalidate": {
      "types": "./dist/revalidate.d.ts",
      "default": "./dist/revalidate.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "default": "./dist/seo.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}

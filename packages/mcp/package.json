    "typecheck": "tsc --noEmit",
    "start:http": "node dist/http.js",
    "prepare": "tsup"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.9.3"
  }
}

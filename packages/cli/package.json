  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "sharp": "^0.35.3"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "optionalDependencies": {
    "sharp": "^0.35.3"
  }
